    <style>
        .results-page {
            max-width: 1100px;
            margin: 40px auto;
            padding: 20px;
        }

        .results-intro {
            text-align: center;
            margin-bottom: 30px;
        }

        .results-status {
            background: #fff3cd;
            border: 1px solid #ffe69c;
            padding: 15px;
            border-radius: 8px;
            margin: 20px 0;
            text-align: center;
        }

        .results-summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 15px;
            margin: 25px 0;
        }

        .summary-card {
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            background: #f5f5f5;
        }

        .summary-card h3 {
            margin-bottom: 8px;
        }

        .summary-card strong {
            font-size: 25px;
        }

        .ward-results {
            margin: 35px 0;
        }

        .ward-results h2 {
            margin-bottom: 15px;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        .results-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 700px;
        }

        .results-table th,
        .results-table td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: center;
        }

        .results-table th {
            background: #f1f1f1;
        }

        .awaiting {
            font-weight: bold;
        }

        .notice {
            margin-top: 35px;
            padding: 20px;
            background: #f8f8f8;
            border-left: 5px solid #555;
            line-height: 1.6;
        }
    </style>
</head>

